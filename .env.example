# Connection string do Neon (Postgres).
# Copie este arquivo para `.env` e cole a sua string em DATABASE_URL.
#
# Onde encontrar: painel do Neon > seu projeto > Connection Details > "Connection string".
# Use a URL com `-pooler` e mantenha `?sslmode=require`.
#
# O app funciona sem esta variavel: tudo fica salvo apenas no SQLite local
# e a sincronizacao aparece como "desativada" na tela de Configuracoes.
DATABASE_URL=postgresql://usuario:senha@ep-exemplo-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
